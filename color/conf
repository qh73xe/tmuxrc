#================================
# COLOUR (Solarized dark)
#================================
set -g status-style "bg=black,fg=yellow"  # base02, yellow

# default window title colors
setw -g window-status-style "fg=brightblue,bg=default,dim"  # base0

# active window title colors
setw -g window-status-current-style "fg=brightred,bg=default,bright" # orange

# pane border
set -g pane-border-style "fg=black"              # base02
set -g pane-active-border-style "fg=brightgreen" # base01

# message text
set -g message-style "bg=colour235,fg=colour180"

# pane number display
set -g display-panes-active-colour blue # blue
set -g display-panes-colour brightred   # orange

# clock
setw -g clock-mode-colour green   # green
